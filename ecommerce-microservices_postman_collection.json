{
  "info": {
    "name": "E-Commerce Microservices",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "userServiceUrl", "value": "http://localhost:8081" },
    { "key": "productServiceUrl", "value": "http://localhost:8082" },
    { "key": "orderServiceUrl", "value": "http://localhost:8083" },
    { "key": "productId", "value": "" },
    { "key": "orderId", "value": "" }
  ],
  "item": [
    {
      "name": "User Service",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{userServiceUrl}}/api/users/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"test123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response has an id and email, but NOT a password', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('id');",
                  "    pm.expect(body.email).to.eql('test@example.com');",
                  "    pm.expect(body).to.not.have.property('password');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Register Duplicate Email (should fail)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{userServiceUrl}}/api/users/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Another User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"test123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 409 Conflict for duplicate email', function () {",
                  "    pm.response.to.have.status(409);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (correct password)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{userServiceUrl}}/api/users/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"test123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response contains correct email', function () {",
                  "    pm.expect(pm.response.json().email).to.eql('test@example.com');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (wrong password, should fail)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{userServiceUrl}}/api/users/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"wrongpassword\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401 Unauthorized', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Product Service",
      "item": [
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{productServiceUrl}}/api/products",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Wireless Mouse\",\n  \"description\": \"Ergonomic mouse\",\n  \"price\": 799.00,\n  \"stock\": 50,\n  \"category\": \"Electronics\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response has expected fields', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.name).to.eql('Wireless Mouse');",
                  "    pm.expect(body.stock).to.eql(50);",
                  "});",
                  "",
                  "// Save the created product's id into a collection variable so",
                  "// later requests (Get, Update, Order placement) can reuse it",
                  "// without you copy-pasting ids manually between requests.",
                  "pm.collectionVariables.set('productId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Product By Id (1st call - cache MISS)",
          "request": {
            "method": "GET",
            "url": "{{productServiceUrl}}/api/products/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// Record response time - compare this against the next request",
                  "// (cache HIT) to demonstrate Redis is actually faster.",
                  "pm.test('Log response time for comparison', function () {",
                  "    console.log('Cache MISS response time (ms):', pm.response.responseTime);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Product By Id (2nd call - cache HIT)",
          "request": {
            "method": "GET",
            "url": "{{productServiceUrl}}/api/products/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Log response time - should usually be faster than the MISS request', function () {",
                  "    console.log('Cache HIT response time (ms):', pm.response.responseTime);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Product By Id - Not Found",
          "request": {
            "method": "GET",
            "url": "{{productServiceUrl}}/api/products/999999"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 404 Not Found', function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get All Products",
          "request": {
            "method": "GET",
            "url": "{{productServiceUrl}}/api/products"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is an array', function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{productServiceUrl}}/api/products/{{productId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Wireless Mouse\",\n  \"description\": \"Ergonomic mouse - updated\",\n  \"price\": 699.00,\n  \"stock\": 40,\n  \"category\": \"Electronics\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Price was actually updated', function () {",
                  "    pm.expect(pm.response.json().price).to.eql(699.00);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Product After Update (verifies cache refreshed, not stale)",
          "request": {
            "method": "GET",
            "url": "{{productServiceUrl}}/api/products/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// If @CachePut wasn't working correctly, this would still",
                  "// show the OLD price (799.00) even after the update above.",
                  "pm.test('Reflects the UPDATED price, proving cache is not stale', function () {",
                  "    pm.expect(pm.response.json().price).to.eql(699.00);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Order Service",
      "item": [
        {
          "name": "Place Order (valid stock)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{orderServiceUrl}}/api/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"items\": [\n    { \"productId\": {{productId}}, \"quantity\": 2 }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Order status is CONFIRMED', function () {",
                  "    pm.expect(pm.response.json().status).to.eql('CONFIRMED');",
                  "});",
                  "",
                  "pm.test('Total amount was calculated from live product price, not client-supplied', function () {",
                  "    const body = pm.response.json();",
                  "    // 2 units at 699.00 (the updated price) = 1398.00",
                  "    pm.expect(body.totalAmount).to.eql(1398.00);",
                  "});",
                  "",
                  "pm.collectionVariables.set('orderId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Place Order (quantity exceeds stock - should fail)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{orderServiceUrl}}/api/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"items\": [\n    { \"productId\": {{productId}}, \"quantity\": 999999 }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 409 Conflict for insufficient stock', function () {",
                  "    pm.response.to.have.status(409);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Place Order (nonexistent product - should fail cleanly)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{orderServiceUrl}}/api/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"items\": [\n    { \"productId\": 999999, \"quantity\": 1 }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 404, not a raw 500 error', function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "",
                  "// This proves GlobalExceptionHandler's FeignException.NotFound",
                  "// handler is correctly translating Product Service's 404",
                  "// into a clean response instead of leaking a Feign stack trace.",
                  "pm.test('Error message is clean, not a stack trace', function () {",
                  "    pm.expect(pm.response.json().message).to.eql('Referenced product does not exist');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Order By Id",
          "request": {
            "method": "GET",
            "url": "{{orderServiceUrl}}/api/orders/{{orderId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Order contains the item(s) placed', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.items).to.have.lengthOf(1);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Orders By User",
          "request": {
            "method": "GET",
            "url": "{{orderServiceUrl}}/api/orders?userId=1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is an array with at least 1 order', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.be.an('array');",
                  "    pm.expect(body.length).to.be.above(0);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
